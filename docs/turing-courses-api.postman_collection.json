            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana López\",\n  \"email\": \"ana@demo.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
